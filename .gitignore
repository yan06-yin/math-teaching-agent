# 环境变量（含 API Key、JWT 密钥等敏感信息）
.env
.env.local
.env.production

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# 前端依赖
node_modules/
.next/

# 数据库（SQLite）
*.db
*.sqlite
*.sqlite3

# 上传文件（用户数据）
uploads/*
!uploads/.gitkeep

