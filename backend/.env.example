# Agnes AI API 配置（必填，或在管理后台配置）
# 获取：在 https://apihub.agnes-ai.com 注册账号并生成 API Key
AGNES_API_KEY=your_agnes_api_key_here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# JWT 密钥（生产环境务必修改为随机字符串）
SECRET_KEY=math-teaching-secret-key-change-in-production

# 数据库（默认 SQLite，生产用 PostgreSQL）
# DATABASE_URL=postgresql://user:pass@host:5432/db

# 如需使用 DeepSeek 等其他模型，可在管理后台 -> AI 模型 中手动添加
