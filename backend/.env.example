# ===================================
# 数学教学智能体 — 环境变量配置模板
# ===================================
# 复制此文件为 .env 并按需修改
# cp .env.example .env
#
# 安全注意事项：
# 1. .env 文件包含敏感信息（API Key、密钥），不要提交到 Git
# 2. 生产环境请使用强密码/密钥，不要使用示例值
# 3. 生产环境务必设置 ENVIRONMENT=production

# --- AI API（必填） ---
# 获取：在 https://apihub.agnes-ai.com 注册并生成 API Key
AGNES_API_KEY=your_agnes_api_key_here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# --- JWT 密钥（生产环境必填） ---
# 生产环境请使用以下命令生成强密钥并设置：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 然后将生成的字符串填入下方
# SECRET_KEY=

# --- 运行环境 ---
# 可选：development / production
# 生产环境设置为 production 后，异常详情不会泄露给客户端
# ENVIRONMENT=production

# --- 管理员密码（生产环境必填） ---
# 首次启动时创建管理员账号使用此密码
# 如果未设置，会自动生成随机密码并打印到控制台
# ADMIN_PASSWORD=your_admin_password_here

# --- 数据库 ---
# 默认 SQLite（开发用）；生产推荐 PostgreSQL
# DATABASE_URL=postgresql://user:pass@host:5432/db

# --- 日志级别 ---
# 可选: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- 跨域白名单（生产环境请限制） ---
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- 如需 DeepSeek 等其他模型 ---
# 在管理后台 -> AI 模型 中手动添加，无需配环境变量